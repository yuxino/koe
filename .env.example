PORT=8787
# 实时识别 + 翻译（必需，安装脚本会把它存进 macOS 钥匙串）
DASHSCOPE_API_KEY=
# 实时识别模型（qwen-audio-3.0-asr-flash-streaming / fun-asr-realtime）
KOE_REALTIME_MODEL=qwen-audio-3.0-asr-flash-streaming
# 实时识别单帧音频时长（ms）：官方建议 100ms/帧（16kHz 单声道即 3200 字节）
KOE_REALTIME_FRAME_MS=100
# 实时识别发送节奏（ms/帧）：按实时节奏发才不会把连接灌断，0 表示不限速
KOE_REALTIME_PACE_MS=100
# 实时识别空闲补静音间隔（ms）：音频停顿期间保持连接存活
KOE_REALTIME_KEEPALIVE_MS=2000
# 翻译并发数
KOE_TRANSLATE_CONCURRENCY=4
# 同时允许的实时字幕会话数
KOE_CAPTURE_MAX_SESSIONS=1
