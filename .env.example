PORT=8787
ASR_PROVIDER=dashscope
ASR_MODEL=fun-asr-flash-2026-06-15
ASR_SEGMENT_SECONDS=60
ASR_CONCURRENCY=8
ASR_MAX_CONCURRENT=8
LOCAL_EXTRACT_CONCURRENCY=4
# 双语翻译（识别后把字幕翻译成目标语言，弹窗可单独开关）
KOE_TRANSLATE=1
KOE_TRANSLATE_MODEL=qwen-mt-turbo
KOE_TRANSLATE_TARGET=zh
KOE_TRANSLATE_CONCURRENCY=4
DASHSCOPE_API_KEY=
KOE_API_TOKEN=
FFMPEG_BIN=ffmpeg
# 可选兜底：不设置也可以，只在拿不到视频直链时用到
YTDLP_BIN=yt-dlp
# 本地助手模式（仅发送提取后的音频到远端 Koe）
# KOE_REMOTE_URL=https://koe-api.yuxino.cn
# KOE_REMOTE_TOKEN=...
# 本地识别模式：本机直接调用 DashScope 识别/翻译，不经线上服务器
KOE_LOCAL_ASR=1
# 流式提取：边下载边切块识别，出字幕更快；失败自动回退整段提取
KOE_STREAM_EXTRACT=1
# 后续切块大小（秒）：首块固定 5 秒出第一批字幕；块越大请求越少、整体越快
KOE_STREAM_CHUNK_SECONDS=30
# 流式识别并行块数：识别与下载同时进行，避免字幕追不上
KOE_STREAM_WORKERS=8
# 实时识别：走 WebSocket 边流边出字，第一句字幕秒出；失败自动回退普通流式
KOE_REALTIME_ASR=1
# 实时识别模型（qwen-audio-3.0-asr-flash-streaming / fun-asr-realtime）
KOE_REALTIME_MODEL=qwen-audio-3.0-asr-flash-streaming
# 实时断句静音阈值（ms），越小句子出得越快
KOE_REALTIME_SILENCE_MS=800
# 实时识别结束等待上限（ms）：视频越长服务端积压越多，需等它把尾巴吐完
KOE_REALTIME_FINISH_TIMEOUT_MS=600000
# 实时识别中音频卡住多久判定失败（ms）
KOE_REALTIME_STALL_MS=60000
# 已完成任务保留时长（ms），超出后自动从内存释放，防止助手长时间运行越占越多
KOE_JOB_TTL_MS=1800000
