# The default is mock, so the project runs without credentials.
ASR_PROVIDER=mock

# To use the ding-frame-style Fun-ASR adapter:
# ASR_PROVIDER=dashscope
# DASHSCOPE_API_KEY=your-api-key
# ASR_MODEL=fun-asr-flash-2026-06-15
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

PORT=8787
ASR_CHUNK_SECONDS=15

# Recommended when the API is exposed on the public internet.
# KOE_API_TOKEN=generate-a-long-random-token
