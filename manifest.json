{
  "manifest_version": 3,
  "name": "Koe",
  "version": "0.3.68",
  "description": "Batch-analyze videos first, then load accurate timestamped captions.",
  "icons": {
    "16": "assets/koe-avatar-16.png",
    "48": "assets/koe-avatar-48.png",
    "128": "assets/koe-avatar-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Koe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": []
}
